# This .gitignore file is configured for Unity projects (Unity 6 / URP compatible)
# Reference: https://github.com/github/gitignore/blob/main/Unity.gitignore

# =========================================================================
# Unity project folders to ignore
# =========================================================================
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset Store Tools plugin (if any)
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# =========================================================================
# Visual Studio / Rider / MonoDevelop / IDE Cache & Generated Files
# =========================================================================
.vs/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files for deleted/temporary assets
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reports
sysinfo.txt

# =========================================================================
# Builds & Packages
# =========================================================================
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# =========================================================================
# OS Generated Files
# =========================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini